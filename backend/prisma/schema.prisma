generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  phone        String        @unique
  name         String?
  email        String?       @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  transactions Transaction[]
  orderCodes   OrderCode[]
}

model Merchant {
  id           String        @id @default(cuid())
  name         String
  category     String?
  email        String        @unique
  passwordHash String
  apiKey       String        @unique @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  transactions Transaction[]
  orderCodes   OrderCode[]
}

// A transaction is created by the merchant when a purchase occurs.
// It becomes linked to a user once they sync it via a SyncCode.
model Transaction {
  id         String    @id @default(cuid())
  merchantId String
  userId     String?
  total      Decimal   @db.Decimal(10, 2)
  currency   String    @default("USD")
  // items stored as JSON: [{ name, price, quantity, sku? }]
  items      Json
  // any extra metadata the merchant wants to attach
  metadata   Json?
  syncedAt   DateTime?
  createdAt  DateTime  @default(now())

  merchant  Merchant   @relation(fields: [merchantId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  syncCode  SyncCode?
}

// A short-lived code (or QR payload) that the user scans/enters to
// claim ownership of a transaction.
model SyncCode {
  id            String      @id @default(cuid())
  transactionId String      @unique
  code          String      @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
}

// Generated by the user when they want to repeat an order at a merchant.
// The merchant scans this to get the items automatically.
model OrderCode {
  id         String    @id @default(cuid())
  userId     String
  merchantId String
  // items the user selected for the repeat order
  items      Json
  code       String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])
}
